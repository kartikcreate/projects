<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

  <persistence-unit name="db-config" transaction-type="RESOURCE_LOCAL">
    
    <!-- Provider Hibernate Core Dependecy -->
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    
    <!-- Hibernate version 4.2 or older, use this
    <provider>org.hibernate.ejb.HibernatePersistence</provider> -->
    
    <!-- Register all models -->
    
    <properties>

<property name="jakarta.persistence.jdbc.driver"
          value="org.postgresql.Driver"/>

<property name="jakarta.persistence.jdbc.url"
          value="jdbc:postgresql://localhost:5432/one-many-bi-dir-db"/><!-- change rhis onlyone-one-bi-dir-db -->

<property name="jakarta.persistence.jdbc.user"
          value="postgres"/>

<property name="jakarta.persistence.jdbc.password"
          value="adishesha"/>

      <!-- Dialect compatibility PostgreSQL 10 -->
     <property name="hibernate.dialect"
          value="org.hibernate.dialect.PostgreSQLDialect"/>
      <!-- Attention, this option can cause data destroy in db. Use caution.
          Values: validate, update, create, create-drop -->
      <property name="hibernate.hbm2ddl.auto" value="update"/>

      <!-- Show SQL in console-->
      <property name="hibernate.show_sql" value="true"/>

      <!-- Show SQL formatted -->
      <property name="hibernate.format_sql" value="true"/>

    </properties>

  </persistence-unit>
</persistence>